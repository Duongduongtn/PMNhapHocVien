# Mẫu biến môi trường cho dịch vụ VPS (TDD §15).
# Chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Tạo chuỗi bí mật: openssl rand -hex 32

# ── Backend VPS ──
APP_DOMAIN=https://thu-nhan.example.vn
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-32-ky-tu
ANH_THO_DIR=/data/anh-tho
PII_RETENTION_DAYS=30
TOOL_API_KEY=doi-thanh-key-ngau-nhien-cho-tool

# ── PostgreSQL (docker-compose) ──
POSTGRES_DB=thunhan_db
POSTGRES_USER=thunhan
POSTGRES_PASSWORD=doi-thanh-mat-khau-manh

# ── Chạy server cục bộ KHÔNG qua docker (tùy chọn, dev) ──
# docker-compose tự dựng DATABASE_URL trỏ service "postgres".
# Khi chạy uvicorn trực tiếp trên máy, bỏ dấu # và trỏ postgres local:
# DATABASE_URL=postgresql+psycopg://thunhan:thunhan@localhost:5432/thunhan_db
