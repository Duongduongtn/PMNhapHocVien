# Tool máy DB — biến môi trường mẫu. KHÔNG commit file .env thật.
# Cấu hình thật (SQL Server + VPS) sẽ lưu MÃ HÓA cục bộ qua màn Cấu hình (HTG-01, task 4);
# .env này chỉ dùng cho dev/khung.

# Cổng tool (đã ghi sổ ~/.claude/local-ports.md)
TOOL_API_PORT=8000

# SQL Server GPLX_CSDT (dùng login riêng, KHÔNG dùng sa)
SQLSERVER_HOST=<ten-may-db>
SQLSERVER_DB=GPLX_CSDT
SQLSERVER_USER=<login-rieng>
SQLSERVER_PASSWORD=<...>

# Backend VPS (tool pull ra qua HTTPS)
VPS_API_URL=https://<domain>/api
VPS_TOOL_KEY=<random-key-cho-tool>
